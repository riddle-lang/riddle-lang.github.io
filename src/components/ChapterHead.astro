---
import type { Chapter } from '../i18n';

interface Props {
  chapter: Chapter;
  index: string;
}

const { chapter, index } = Astro.props;
---

<div id={chapter.id} class="scroll-mt-32 pt-24 first:pt-8">
  <div class="shell">
    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-t border-line pt-5">
      <span class="font-mono text-[12.5px] tabular-nums text-brand">{index}</span>
      <p class="text-[12.5px] font-medium tracking-[0.14em] text-muted uppercase">
        {chapter.label}
      </p>
      <p class="w-full text-[13px] leading-relaxed text-muted/80 sm:ms-auto sm:w-auto">
        {chapter.blurb}
      </p>
    </div>
  </div>
</div>
