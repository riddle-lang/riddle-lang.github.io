---
import SectionHead from './SectionHead.astro';
import { inline } from '../lib/inline';
import type { SiteContent } from '../i18n';

interface Props {
  t: SiteContent;
}

const { t } = Astro.props;
---

<section id="docs" class="section border-t border-line bg-surface/45">
  <div class="shell">
    <SectionHead eyebrow={t.docs.eyebrow} title={t.docs.title} subtitle={t.docs.subtitle} />

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        t.docs.groups.map((group, index) => (
          <div
            class="reveal rounded-[var(--radius-card)] border border-line p-5"
            style={`transition-delay:${index * 40}ms`}
          >
            <h3 class="text-[14px] font-medium tracking-tight">{group.title}</h3>
            <ul class="mt-4 space-y-3">
              {group.items.map((item) => (
                <li>
                  <a class="group/link block" href={item.href}>
                    <span class="text-[13.5px] text-ink transition-colors group-hover/link:text-brand">
                      {item.label}
                    </span>
                    <span class="block text-[12.5px] leading-relaxed text-muted">{item.desc}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p
      class="mt-8 max-w-3xl text-[13.5px] leading-relaxed text-muted"
      set:html={inline(t.docs.footnote, t.glossary)}
    />
  </div>
</section>
