---
import SectionHead from './SectionHead.astro';
import { inline } from '../lib/inline';
import type { SiteContent } from '../i18n';

interface Props {
  t: SiteContent;
}

const { t } = Astro.props;
---

<section id="faq" class="section">
  <div class="shell">
    <SectionHead eyebrow={t.faq.eyebrow} title={t.faq.title} subtitle={t.faq.subtitle} />

    <div class="mt-14 grid gap-3 lg:grid-cols-2">
      {
        t.faq.items.map((item, index) => (
          <details
            class="reveal group h-fit rounded-[var(--radius-card)] border border-line p-5 transition-colors open:bg-surface/50"
            style={`transition-delay:${index * 30}ms`}
          >
            <summary class="flex cursor-pointer list-none items-start gap-3 text-[15px] font-medium tracking-tight">
              <span
                class="mt-[7px] size-1.5 shrink-0 rounded-full bg-brand transition-transform group-open:scale-150"
                aria-hidden="true"
              />
              <span set:html={inline(item.q, t.glossary)} />
            </summary>
            <p
              class="mt-3 ps-[18px] text-[13.5px] leading-relaxed text-muted"
              set:html={inline(item.a, t.glossary)}
            />
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
