---
import type { SiteContent } from '../i18n';

interface Props {
  t: SiteContent;
}

const { t } = Astro.props;
const year = 2026;
---

<footer class="border-t border-line bg-surface/45">
  <div class="shell grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <a href={t.dir.self} class="flex items-center gap-2 text-[15px] font-semibold tracking-tight">
        <img src="/logo.svg" alt="" width="24" height="24" class="size-6" />
        <span>Riddle</span>
      </a>
      <p class="mt-3 max-w-xs text-[13.5px] leading-relaxed text-muted">{t.footer.tagline}</p>
      <p class="mt-5 text-[13px] text-muted">
        <span class="text-muted/70">{t.footer.community}</span>
        <span class="ms-2 font-mono">{t.footer.communityValue}</span>
      </p>
    </div>

    {
      t.footer.groups.map((group) => (
        <nav>
          <h2 class="text-[13px] font-medium tracking-tight">{group.title}</h2>
          <ul class="mt-4 space-y-2.5">
            {group.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-[13.5px] text-muted transition-colors hover:text-brand"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="shell flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-line py-6 text-[12.5px] text-muted">
    <span>© {year} {t.footer.copyright}</span>
    <a
      href="https://github.com/riddle-lang/riddle/blob/main/LICENSE"
      class="transition-colors hover:text-brand"
    >
      {t.footer.license}
    </a>
    <a href={t.dir.other} class="ms-auto transition-colors hover:text-brand" title={t.dir.otherTitle}>
      {t.dir.otherLabel}
    </a>
  </div>
</footer>
