---
import { inline } from '../lib/inline';

interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  align?: 'start' | 'center';
  class?: string;
}

const { eyebrow, title, subtitle, align = 'start', class: className = '' } = Astro.props;
---

<header
  class:list={[
    'reveal max-w-2xl',
    align === 'center' && 'mx-auto text-center',
    className,
  ]}
>
  <p class="text-[13px] font-medium tracking-[0.14em] text-brand uppercase">{eyebrow}</p>
  <h2 class="headline mt-3 text-[clamp(2rem,4.4vw,3rem)]" set:html={inline(title)} />
  {
    subtitle && (
      <p
        class="mt-4 text-[clamp(1rem,1.5vw,1.15rem)] leading-relaxed text-muted"
        set:html={inline(subtitle)}
      />
    )
  }
</header>
