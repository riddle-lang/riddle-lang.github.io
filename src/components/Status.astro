---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { inline } from '../lib/inline';
import type { SiteContent } from '../i18n';

interface Props {
  t: SiteContent;
}

const { t } = Astro.props;
---

<section id="status" class="section">
  <div class="shell">
    <SectionHead eyebrow={t.status.eyebrow} title={t.status.title} subtitle={t.status.subtitle} />

    <div class="mt-14 grid gap-5 md:grid-cols-2">
      <div class="reveal rounded-[var(--radius-card)] border border-line bg-surface/50 p-7">
        <h3 class="flex items-center gap-2 text-[15px] font-medium tracking-tight">
          <Icon name="check" size={16} class="text-brand" />
          {t.status.worksTitle}
        </h3>
        <ul class="mt-5 space-y-2.5">
          {
            t.status.works.map((row) => (
              <li class="flex gap-2.5 text-[14px] leading-relaxed text-muted">
                <span class="mt-[8px] size-1 shrink-0 rounded-full bg-brand" aria-hidden="true" />
                <span set:html={inline(row)} />
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="reveal rounded-[var(--radius-card)] border border-dashed border-line p-7"
        style="transition-delay:90ms"
      >
        <h3 class="flex items-center gap-2 text-[15px] font-medium tracking-tight text-muted">
          <Icon name="dot" size={16} />
          {t.status.limitsTitle}
        </h3>
        <ul class="mt-5 space-y-2.5">
          {
            t.status.limits.map((row) => (
              <li class="flex gap-2.5 text-[14px] leading-relaxed text-muted/85">
                <span
                  class="mt-[8px] size-1 shrink-0 rounded-full bg-muted/50"
                  aria-hidden="true"
                />
                <span set:html={inline(row)} />
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p
      class="reveal mt-8 max-w-3xl text-[14px] leading-relaxed text-muted"
      set:html={inline(t.status.note)}
    />
  </div>
</section>
